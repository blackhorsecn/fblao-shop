From f011055b4b4c02da605d6832175e1a02858937c0 Mon Sep 17 00:00:00 2001
From: soft3vhs <admin@drl-softechs.dev>
Date: Mon, 10 Aug 2026 14:33:44 +0000
Subject: [PATCH 2/4] Require Swiftpay API key + secret before enabling
 Swiftpay

---
 src/swiftpay.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/swiftpay.js b/src/swiftpay.js
index 6c0168c..40b45c0 100644
--- a/src/swiftpay.js
+++ b/src/swiftpay.js
@@ -23,7 +23,8 @@ function apiBase() {
 function isConfigured() {
   const enabled = getSetting('swiftpay_enabled') === '1' || process.env.SWIFTPAY_ENABLED === '1';
   const accessKey = settingOrEnv('swiftpay_api_key', 'SWIFTPAY_API_KEY');
-  return enabled && !!accessKey;
+  const secretKey = settingOrEnv('swiftpay_api_secret', 'SWIFTPAY_API_SECRET');
+  return enabled && !!accessKey && !!secretKey;
 }
 
