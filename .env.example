# Server
PORT=3000
NODE_ENV=production
# Railway: mount a persistent volume at /data and keep DATA_DIR pointed there
DATA_DIR=/data
# Optional SQLite file override. Leave blank to use {DATA_DIR}/shop.db.
# DATABASE_URL=sqlite:///data/shop.db
# SQLITE_PATH=/data/shop.db
SESSION_SECRET=your-session-secret-here
# Public base URL of this site (used to build Maya redirect/webhook URLs)
BASE_URL=https://yourdomain.example

# Admin login (used only to seed the first admin if DB is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_TELEGRAM_ID=your-telegram-id

# PayMongo integration (optional)
PAYMONGO_ENABLED=0
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret

# Xendit integration (optional)
XENDIT_ENABLED=0
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_CALLBACK_TOKEN=your-xendit-callback-token

# Maya keys can also be configured later in the Admin > Settings page.
# These values seed the database on first run.
MAYA_MODE=sandbox
MAYA_PUBLIC_KEY=pk-...
MAYA_SECRET_KEY=sk-...
MAYA_WEBHOOK_SECRET=your-maya-webhook-secret

# Coins.ph support (optional)
COINS_MODE=sandbox
COINS_API_KEY=your-coins-api-key
COINS_API_SECRET=your-coins-api-secret
COINS_WEBHOOK_SECRET=your-coins-webhook-secret

# Swiftpay PH support (optional)
# Sandbox: https://api.pay.sandbox.live.swiftpay.ph  |  Prod: https://api.pay.live.swiftpay.ph
# SWIFTPAY_API_KEY   = x_access_key (merchant access key from the Merchant Portal)
# SWIFTPAY_API_SECRET = secret key (32 chars, used for HMAC-SHA256 request signing)
SWIFTPAY_ENABLED=0
SWIFTPAY_MODE=sandbox
SWIFTPAY_API_BASE_URL=
SWIFTPAY_API_KEY=your-swiftpay-access-key
SWIFTPAY_API_SECRET=your-swiftpay-secret-key-32chars

# Magpie support (optional)
MAGPIE_ENABLED=0
MAGPIE_MODE=sandbox
MAGPIE_API_BASE_URL=
MAGPIE_API_KEY=your-magpie-api-key
MAGPIE_API_SECRET=your-magpie-api-secret
MAGPIE_WEBHOOK_SECRET=your-magpie-webhook-secret
MAGPIE_TARGET_CURRENCY=CNY

CURRENCY=PHP
