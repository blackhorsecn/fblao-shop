# Server
PORT=3000
SESSION_SECRET=your-session-secret-here
# Public base URL of this site (used to build Maya redirect/webhook URLs)
BASE_URL=http://localhost:3000

# Admin login (used only to seed the first admin if DB is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# Maya keys can also be configured later in the Admin > Settings page.
# These values seed the database on first run.
MAYA_MODE=sandbox
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=

CURRENCY=PHP
