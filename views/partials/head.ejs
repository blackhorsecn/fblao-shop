<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= shopName %></title>
  <% if (settings.cf_site_verification) { %>
    <meta name="cloudflare-site-verification" content="<%= settings.cf_site_verification.replace('cloudflare-site-verification=', '') %>">
  <% } %>
  <link rel="stylesheet" href="/static/css/style.css">
  <% if (settings.cf_turnstile_site_key) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" style="background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">🦁</span>
      <span class="brand-text" style="background: linear-gradient(135deg, #fff, #bbb); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= shopName %></span>
    </a>
    <nav class="main-nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Shop</a>
      <a href="/query" class="<%= currentPath === '/query' ? 'active' : '' %>">Query Order</a>
      <a href="/admin" class="nav-admin">Admin</a>

      <% if (user) { %>
        <div class="user-profile" style="display: flex; align-items: center; gap: 8px;">
          <% if (user.photo_url) { %>
            <img src="<%= user.photo_url %>" alt="Profile" style="width: 24px; height: 24px; border-radius: 50%;">
          <% } %>
          <span class="user-name" style="font-weight: bold;">@<%= user.username %></span>
          <a href="https://t.me/mm6668mm" target="_blank" class="btn btn-sm" style="background: #0088cc; color: white; padding: 4px 10px;">Chat Support</a>
          <a href="/logout" class="nav-logout" style="font-size: 0.8em; color: var(--muted);">Logout</a>
        </div>
      <% } else if (settings.telegram_bot_username) { %>
        <div class="tg-login">
          <script async src="https://telegram.org/js/telegram-widget.js?22"
            data-telegram-login="<%= settings.telegram_bot_username %>"
            data-size="medium"
            data-userpic="false"
            data-auth-url="/auth/telegram"
            data-request-access="write"></script>
        </div>
      <% } %>
    </nav>
  </div>
  <% if (typeof shopTagline !== 'undefined' && shopTagline) { %>
    <div class="tagline"><div class="container"><%= shopTagline %></div></div>
  <% } %>
</header>
<main class="container page">
