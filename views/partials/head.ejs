<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= shopName %></title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" style="background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">🦁</span>
      <span class="brand-text" style="background: linear-gradient(135deg, #fff, #bbb); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= shopName %></span>
    </a>
    <nav class="main-nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Shop</a>
      <a href="/query" class="<%= currentPath === '/query' ? 'active' : '' %>">Query Order</a>
      <a href="/admin" class="nav-admin">Admin</a>
    </nav>
  </div>
  <% if (typeof shopTagline !== 'undefined' && shopTagline) { %>
    <div class="tagline"><div class="container"><%= shopTagline %></div></div>
  <% } %>
</header>
<main class="container page">
