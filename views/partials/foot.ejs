</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <img src="/logo.png" alt="<%= escapeHtml(shopName) %>" loading="lazy">
    </div>
    <div class="payment-methods" style="margin-bottom: 20px; display: flex; justify-content: center; gap: 25px; align-items: center; flex-wrap: wrap;">
       <img src="<%= getIcon('visa') %>" alt="Visa" style="height: 18px;">
       <img src="<%= getIcon('mastercard') %>" alt="Mastercard" style="height: 30px;">
       <% if (mayaEnabled) { %>
         <img src="<%= getIcon('maya') %>" alt="Maya" style="height: 24px;">
       <% } %>
       <% if (coinsEnabled) { %>
         <img src="<%= getIcon('coins') %>" alt="Coins.ph" style="height: 24px;">
       <% } %>
       <% if (paymongoEnabled) { %>
         <img src="<%= getIcon('paymongo') %>" alt="PayMongo" style="height: 24px;">
       <% } %>
       <% if (xenditEnabled) { %>
         <img src="<%= getIcon('xendit') %>" alt="Xendit" style="height: 24px;">
       <% } %>
       <% footerMethods.forEach(function(m){ %>
         <% var icon = getIcon(m.name, m.icon_url); %>
         <% if (icon && !['visa','mastercard','maya','paymaya','paymongo','xendit','coins','coins.ph','coinsph'].some(v => m.name.toLowerCase().includes(v))) { %>
           <img src="<%= icon %>" alt="<%= m.name %>" style="height: 24px;">
         <% } %>
       <% }) %>
    </div>
    <p>&copy; <%= shopName %>. All accounts are for authorized use only.</p>
    <p>Current Time (PH): <span id="live-clock" style="color: var(--accent); font-weight: bold; font-family: ui-monospace, monospace;"><%= date(new Date().toISOString()) %></span></p>
    <p>Support: <a href="https://t.me/mm6668mm" target="_blank" style="color: #0088cc; font-weight: bold;">@mm6668mm</a></p>
    <p class="muted">Powered by <span class="shining-gold">BlackHorse</span> · Digital goods delivered to your TG immediately.</p>
  </div>
</footer>
<script src="/static/js/main.js"></script>
</body>
</html>
