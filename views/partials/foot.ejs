</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <img src="/logo.png" alt="<%= escapeHtml(shopName) %>" loading="lazy">
    </div>
    <div class="payment-methods">
       <img class="payment-icon payment-icon-visa" src="<%= getIcon('visa') %>" alt="Visa">
       <img class="payment-icon payment-icon-mastercard" src="<%= getIcon('mastercard') %>" alt="Mastercard">
       <% if (mayaEnabled) { %>
         <img class="payment-icon" src="<%= getIcon('maya') %>" alt="Maya">
       <% } %>
       <% if (coinsEnabled) { %>
         <img class="payment-icon" src="<%= getIcon('coins') %>" alt="Coins.ph">
       <% } %>
       <% if (paymongoEnabled) { %>
         <img class="payment-icon" src="<%= getIcon('paymongo') %>" alt="PayMongo">
       <% } %>
       <% if (xenditEnabled) { %>
         <img class="payment-icon" src="<%= getIcon('xendit') %>" alt="Xendit">
       <% } %>
       <% if (swiftpayEnabled) { %>
         <img class="payment-icon" src="<%= getIcon('swiftpay') %>" alt="Swiftpay PH">
       <% } %>
       <% footerMethods.forEach(function(m){ %>
         <% var icon = getIcon(m.name, m.icon_url); %>
         <% if (icon && !['visa','mastercard','maya','paymaya','paymongo','xendit','coins','coins.ph','coinsph','swiftpay','swiftpay ph','swiftpayph'].some(v => m.name.toLowerCase().includes(v))) { %>
           <img class="payment-icon" src="<%= icon %>" alt="<%= m.name %>">
         <% } %>
       <% }) %>
    </div>
    <p>&copy; <%= shopName %>. All accounts are for authorized use only.</p>
    <p>Current Time (PH): <span id="live-clock" style="color: var(--accent); font-weight: bold; font-family: ui-monospace, monospace;"><%= date(new Date().toISOString()) %></span></p>
    <p>Support: <a href="https://t.me/BMXTORE" target="_blank" style="color: #0088cc; font-weight: bold;">@BMXTORE</a></p>
    <p class="muted">Simple checkout, clear pricing, and buyer-friendly payment options.</p>
    <% if (magpieEnabled) { %>
      <p class="muted">Chinese buyers: Alipay / WeChat Pay supported when available.</p>
    <% } %>
  </div>
</footer>
<script src="/static/js/main.js"></script>
</body>
</html>
