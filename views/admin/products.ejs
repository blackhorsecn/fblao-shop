<%- include('partials/head') %>
<h1>Products</h1>

<div style="margin-bottom: 20px;">
  <form method="POST" action="/admin/products/sync-all">
    <button class="btn btn-sm" type="submit" style="background:#eee;color:#333;">Force Sync All Stock Counts</button>
  </form>
</div>

<div class="subpanel" style="margin-bottom:20px;">
  <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
    <h2 style="margin:0;">Add product</h2>
  </div>
  <% if (!categories.length) { %>
    <p class="muted">Create a <a href="/admin/categories">category</a> first.</p>
  <% } else { %>
  <form method="POST" action="/admin/products">
    <div class="field-row">
      <label class="field"><span>Category</span>
        <select name="category_id">
          <% categories.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select></label>
      <label class="field"><span>Name</span><input type="text" name="name" required></label>
    </div>
    <label class="field"><span>Description</span><input type="text" name="description"></label>
    <div class="field-row">
      <label class="field"><span>Price</span><input type="number" step="0.01" name="price" value="0" required></label>
      <label class="field"><span>Sort</span><input type="number" name="sort_order" value="0"></label>
      <label class="field" style="flex:0 0 100px;"><span>Auto-Deliver</span><input type="checkbox" name="auto_deliver" checked></label>
      <label class="field" style="flex:0 0 70px;"><span>Active</span><input type="checkbox" name="active" checked></label>
    </div>
    <button class="btn btn-primary" type="submit">Add product</button>
  </form>
  <% } %>
</div>

<% if (!products.length) { %><div class="empty-state">No products yet.</div><% } %>

<% products.forEach(function(p){ %>
  <div class="subpanel" style="margin-bottom:12px; <%= p.stock === 0 ? 'border-left: 4px solid #ff4d4d;' : '' %>">
    <form method="POST" action="/admin/products/<%= p.id %>/update">
      <div class="field-row">
        <label class="field"><span>Category</span>
          <select name="category_id">
            <% categories.forEach(function(c){ %>
              <option value="<%= c.id %>" <%= c.id === p.category_id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select></label>
        <label class="field" style="flex:2;"><span>Name</span><input type="text" name="name" value="<%= escapeHtml(p.name) %>"></label>
      </div>
      <label class="field"><span>Description</span><input type="text" name="description" value="<%= escapeHtml(p.description) %>"></label>
      <div class="field-row">
        <label class="field"><span>Price</span><input type="number" step="0.01" name="price" value="<%= p.price %>"></label>
        <label class="field"><span>Stock (Pool)</span>
          <input type="number" value="<%= p.stock %>" readonly disabled style="<%= p.stock === 0 ? 'color: #ff4d4d; font-weight: bold;' : '' %>">
        </label>
        <label class="field"><span>Sort</span><input type="number" name="sort_order" value="<%= p.sort_order %>"></label>
        <label class="field" style="flex:0 0 100px;"><span>Auto-Deliver</span><input type="checkbox" name="auto_deliver" <%= p.auto_deliver ? 'checked' : '' %>></label>
        <label class="field" style="flex:0 0 70px;"><span>Active</span><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>></label>
      </div>
      <div class="row-actions" style="display:flex; gap:5px;">
        <button class="btn btn-sm btn-primary" type="submit">Save Settings</button>
        <a href="/admin/products/<%= p.id %>/stock" class="btn btn-sm" style="background:#eee;color:#333;">Manage Stock Pool</a>
        <form method="POST" action="/admin/products/<%= p.id %>/duplicate" style="margin:0;">
          <button class="btn btn-sm" type="submit" style="background:#eee;color:#333;">Duplicate</button>
        </form>
      </div>
    </form>
    <form class="inline-form" method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?');" style="margin-top:-34px; text-align:right;">
      <button class="btn btn-sm btn-danger" type="submit">Delete</button>
    </form>
  </div>
<% }) %>
<%- include('partials/foot') %>
