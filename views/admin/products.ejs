<%- include('partials/head') %>
<h1>Products</h1>

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; gap: 10px; flex-wrap: wrap;">
  <form method="GET" action="/admin/products" style="display:flex; gap:5px; flex-grow: 1;">
    <input type="text" name="search" value="<%= search || '' %>" placeholder="Search products..." style="padding:4px 8px; border:1px solid #ddd; border-radius:4px; flex-grow: 1; max-width: 300px;">
    <select name="category_id" style="padding:4px; border:1px solid #ddd; border-radius:4px;">
      <option value="">All Categories</option>
      <% categories.forEach(function(c){ %>
        <option value="<%= c.id %>" <%= catFilter === c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-sm">Filter</button>
    <% if (search || catFilter) { %>
      <a href="/admin/products" class="btn btn-sm" style="background:#eee;color:#333;">Clear</a>
    <% } %>
  </form>

  <form method="POST" action="/admin/products/sync-all" style="margin:0;">
    <button class="btn btn-sm" type="submit" style="background:#eee;color:#333;">Sync All Stock</button>
  </form>
</div>

<div class="subpanel" style="margin-bottom:20px; border-top: 4px solid #007bff;">
  <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
    <h2 style="margin:0; font-size: 1.2rem;">Add New Product</h2>
  </div>
  <% if (!categories.length) { %>
    <p class="muted">Create a <a href="/admin/categories">category</a> first.</p>
  <% } else { %>
  <form method="POST" action="/admin/products">
    <div class="field-row">
      <label class="field"><span>Category</span>
        <select name="category_id">
          <% categories.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select></label>
      <label class="field" style="flex: 2;"><span>Name</span><input type="text" name="name" required placeholder="e.g. Aged FB Account"></label>
    </div>
    <label class="field"><span>Description</span><input type="text" name="description" placeholder="Briefly describe what the customer gets"></label>
    <div class="field-row">
      <label class="field"><span>Price</span><input type="number" step="0.01" name="price" value="0" required></label>
      <label class="field"><span>Sort Order</span><input type="number" name="sort_order" value="0"></label>
      <label class="field" style="flex:0 0 100px;"><span>Auto-Deliver</span><input type="checkbox" name="auto_deliver" checked></label>
      <label class="field" style="flex:0 0 70px;"><span>Active</span><input type="checkbox" name="active" checked></label>
    </div>
    <button class="btn btn-primary" type="submit">Add Product</button>
  </form>
  <% } %>
</div>

<% if (!products.length) { %>
  <div class="empty-state">
    <% if (search || catFilter) { %>
      No products match your filters. <a href="/admin/products">Clear filters</a>.
    <% } else { %>
      No products yet.
    <% } %>
  </div>
<% } %>

<% products.forEach(function(p){ %>
  <div class="subpanel" style="margin-bottom:12px; position: relative; <%= p.stock === 0 ? 'border-left: 4px solid #ff4d4d;' : 'border-left: 4px solid #28a745;' %> <%= !p.active ? 'opacity: 0.8;' : '' %>">
    <div style="position: absolute; top: 10px; right: 10px; display: flex; gap: 5px;">
       <form method="POST" action="/admin/products/<%= p.id %>/duplicate" style="margin:0;">
          <button class="btn btn-sm" type="submit" style="background:#eee;color:#333; padding: 2px 8px;" title="Duplicate">Copy</button>
        </form>
        <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?');" style="margin:0;">
          <button class="btn btn-sm btn-danger" type="submit" style="padding: 2px 8px;">&times;</button>
        </form>
    </div>

    <form method="POST" action="/admin/products/<%= p.id %>/update">
      <div class="field-row" style="margin-right: 80px;">
        <label class="field" style="max-width: 200px;"><span>Category</span>
          <select name="category_id">
            <% categories.forEach(function(c){ %>
              <option value="<%= c.id %>" <%= c.id === p.category_id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select></label>
        <label class="field" style="flex:2;"><span>Name</span><input type="text" name="name" value="<%= escapeHtml(p.name) %>"></label>
      </div>

      <label class="field"><span>Description</span><input type="text" name="description" value="<%= escapeHtml(p.description) %>"></label>

      <div class="field-row">
        <label class="field"><span>Price</span><input type="number" step="0.01" name="price" value="<%= p.price %>"></label>
        <label class="field">
          <span>Current Stock</span>
          <div style="display: flex; align-items: center; gap: 5px;">
            <input type="number" name="stock" value="<%= p.stock %>" style="width: 80px; <%= p.stock === 0 ? 'color: #ff4d4d; font-weight: bold;' : 'color: #28a745;' %>" <%= p.auto_deliver ? 'readonly title="Managed by Stock Pool"' : '' %>>
            <% if (p.auto_deliver) { %>
              <a href="/admin/products/<%= p.id %>/stock" class="btn btn-sm" style="background:#eee;color:#333; font-size: 10px; padding: 2px 4px; white-space: nowrap;">Stock Pool</a>
            <% } %>
          </div>
        </label>
        <label class="field" style="max-width: 80px;"><span>Sort</span><input type="number" name="sort_order" value="<%= p.sort_order %>"></label>
        <label class="field" style="flex:0 0 100px;"><span>Auto-Deliver</span><input type="checkbox" name="auto_deliver" <%= p.auto_deliver ? 'checked' : '' %>></label>
        <label class="field" style="flex:0 0 70px;"><span>Active</span><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>></label>
      </div>

      <div class="row-actions" style="display:flex; gap:5px; margin-top: 15px;">
        <button class="btn btn-sm btn-primary" type="submit">Update Details</button>
        <button type="button" class="btn btn-sm" style="background:#007bff; color:white;" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">+ Quick Add Stock</button>
        <div style="display:none; margin-top: 10px; width: 100%; border: 1px solid #ddd; padding: 10px; border-radius: 4px; background: #f9f9f9;">
           <p class="muted" style="margin-top:0;">Paste items (one per line):</p>
           <textarea name="quick_lines" placeholder="email:pass:2fa..." style="width:100%; height:80px; font-family:monospace; margin-bottom:5px;"></textarea>
           <button type="submit" name="action" value="quick_add" class="btn btn-sm btn-primary">Add & Save</button>
        </div>
      </div>
    </form>
  </div>
<% }) %>
<%- include('partials/foot') %>
