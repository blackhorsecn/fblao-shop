<%- include('partials/head') %>
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
  <h1 style="margin:0;">Dashboard Overview</h1>
  <div class="muted" style="font-size: 14px;">Last updated: <%= date(new Date().toISOString()) %></div>
</div>

<div class="panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:15px; margin-bottom:30px;">
  <div class="subpanel" style="padding:15px; border-top: 3px solid var(--blue);">
    <div class="muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Orders Overview</div>
    <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 10px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Total</span>
        <strong style="font-size:18px; color: var(--text);"><%= stats.orders %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Last 24h</span>
        <strong style="font-size:18px; color: var(--blue);"><%= stats.orders24h %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Pending</span>
        <strong style="font-size:18px; color: var(--accent-2);"><%= stats.pending %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Delivered</span>
        <strong style="font-size:18px; color: var(--accent);"><%= stats.delivered %></strong>
      </div>
    </div>
  </div>

  <div class="subpanel" style="padding:15px; border-top: 3px solid var(--gold-gradient);">
    <div class="muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Revenue (Paid/Delivered)</div>
    <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 10px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Today</span>
        <strong style="font-size:18px; color: var(--green);"><%= money(stats.revenueToday) %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">This Month</span>
        <strong style="font-size:18px; color: var(--accent);"><%= money(stats.revenueMonth) %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Total All Time</span>
        <strong style="font-size:18px; background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= money(stats.revenue) %></strong>
      </div>
    </div>
  </div>

  <div class="subpanel" style="padding:15px; border-top: 3px solid var(--purple);">
    <div class="muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Top Selling (Units)</div>
    <div style="display: flex; flex-direction: column; gap: 4px; margin-top: 8px;">
      <% if (stats.topProducts && stats.topProducts.length > 0) { %>
        <% stats.topProducts.forEach(p => { %>
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
            <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px;" title="<%= p.product_name %>"><%= p.product_name %></span>
            <strong style="color: var(--accent);"><%= p.total_sold %></strong>
          </div>
        <% }) %>
      <% } else { %>
        <div class="muted" style="font-size: 12px; text-align: center; margin-top: 10px;">No sales yet</div>
      <% } %>
    </div>
  </div>

  <div class="subpanel" style="padding:15px; border-top: 3px solid var(--red);">
    <div class="muted" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Inventory</div>
    <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 10px;">
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Total Products</span>
        <strong style="font-size:18px;"><%= stats.products %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: baseline;">
        <span class="muted" style="font-size: 13px;">Low Stock</span>
        <strong style="font-size:18px; color: <%= stats.lowStock > 0 ? 'var(--red)' : 'var(--green)' %>;"><%= stats.lowStock %></strong>
      </div>
      <% if (stats.lowStock > 0) { %>
        <a href="/admin/products" class="btn btn-sm" style="margin-top:5px; font-size: 10px; padding: 2px 0; text-align: center; background: rgba(239, 68, 68, 0.1); color: var(--red); border: 1px solid var(--red);">View Low Stock</a>
      <% } %>
    </div>
  </div>
</div>

<div class="admin-bar" style="background: var(--panel); padding: 15px; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 20px; display: flex; flex-direction: column; gap: 15px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
    <div class="row-actions" style="margin:0; display: flex; gap: 5px;">
      <% ['all','pending','paid','delivered','failed','cancelled'].forEach(function(f){ %>
        <a class="btn btn-sm <%= filter === f ? 'btn-primary' : '' %>" href="/admin?status=<%= f %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" style="text-transform: capitalize;"><%= f %></a>
      <% }) %>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/admin/products" class="btn btn-sm btn-primary" style="background: var(--accent);">+ Add Stock</a>
      <a href="/admin/settings" class="btn btn-sm" style="background: var(--panel-2);">Settings</a>
    </div>
  </div>

  <form method="GET" action="/admin" style="display:flex; gap:5px; width: 100%;">
    <input type="hidden" name="status" value="<%= filter %>">
    <div style="position: relative; flex-grow: 1;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--muted);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by order #, email, telegram, or ID..." style="padding:8px 12px 8px 32px; border:1px solid var(--border); border-radius:6px; background: var(--panel-2); color: var(--text); width: 100%;">
    </div>
    <button type="submit" class="btn btn-sm btn-primary">Search</button>
    <% if (search) { %>
      <a href="/admin?status=<%= filter %>" class="btn btn-sm" style="background:var(--panel-2);color:var(--muted);">Clear</a>
    <% } %>
  </form>
</div>

<div class="table-wrap" style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
<table class="product-table">
  <thead>
    <tr>
      <th style="width: 50px;">ID</th>
      <th>Order Info</th>
      <th>Customer (TG)</th>
      <th>Product Details</th>
      <th>Financials</th>
      <th>Status</th>
      <th style="text-align: right;">Action</th>
    </tr>
  </thead>
  <tbody>
    <% if (!orders.length) { %>
      <tr><td colspan="7" class="muted" style="text-align: center; padding: 40px;">No matching orders found.</td></tr>
    <% } %>
    <% orders.forEach(function(o){ %>
      <tr>
        <td class="muted">#<%= o.id %></td>
        <td>
          <div style="font-weight: bold; color: var(--text);"><%= o.order_number %></div>
          <div class="muted" style="font-size: 11px;"><%= date(o.created_at) %></div>
        </td>
        <td>
          <div style="color: var(--accent); font-weight: 600;">@<%= o.telegram_username %></div>
          <div class="muted" style="font-size: 11px;"><%= o.email || 'No email' %></div>
        </td>
        <td>
          <div style="font-weight: 500;"><%= o.product_name %></div>
          <div class="muted" style="font-size: 11px;">Qty: <%= o.quantity %></div>
        </td>
        <td>
          <div style="color: var(--accent-2); font-weight: 700;"><%= money(o.total) %></div>
          <div class="muted" style="font-size: 10px; text-transform: uppercase;"><%= o.payment_type %></div>
        </td>
        <td>
          <span class="status-pill status-<%= o.status %>" style="font-size: 10px; padding: 2px 10px;"><%= o.status %></span>
        </td>
        <td style="text-align: right;">
          <a class="btn btn-sm" href="/admin/orders/<%= o.id %>" style="padding: 4px 12px; font-size: 12px;">Manage</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('partials/foot') %>
