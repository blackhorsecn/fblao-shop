<%- include('partials/head') %>
<h1>Orders</h1>

<div class="panel-grid" style="grid-template-columns: repeat(6, 1fr); gap:10px; margin-bottom:20px;">
  <div class="subpanel" style="padding:12px;"><div class="muted">Total</div><strong style="font-size:20px;"><%= stats.orders %></strong></div>
  <div class="subpanel" style="padding:12px;"><div class="muted">Pending</div><strong style="font-size:20px;"><%= stats.pending %></strong></div>
  <div class="subpanel" style="padding:12px;"><div class="muted">Paid</div><strong style="font-size:20px;"><%= stats.paid %></strong></div>
  <div class="subpanel" style="padding:12px;"><div class="muted">Delivered</div><strong style="font-size:20px;"><%= stats.delivered %></strong></div>
  <div class="subpanel" style="padding:12px;"><div class="muted">Products</div><strong style="font-size:20px;"><%= stats.products %></strong></div>
  <div class="subpanel" style="padding:12px;"><div class="muted">Revenue</div><strong style="font-size:20px;"><%= money(stats.revenue) %></strong></div>
</div>

<div class="admin-bar">
  <div class="row-actions">
    <% ['all','pending','paid','delivered','failed','cancelled'].forEach(function(f){ %>
      <a class="btn btn-sm <%= filter === f ? 'btn-primary' : '' %>" href="/admin?status=<%= f %>"><%= f %></a>
    <% }) %>
  </div>
</div>

<table class="data-table">
  <thead>
    <tr><th>#</th><th>Order</th><th>Email</th><th>Product</th><th>Qty</th><th>Total</th><th>Pay</th><th>Status</th><th>Placed</th><th></th></tr>
  </thead>
  <tbody>
    <% if (!orders.length) { %>
      <tr><td colspan="10" class="muted">No orders.</td></tr>
    <% } %>
    <% orders.forEach(function(o){ %>
      <tr>
        <td><%= o.id %></td>
        <td><strong><%= o.order_number %></strong></td>
        <td><%= o.email %></td>
        <td><%= o.product_name %></td>
        <td><%= o.quantity %></td>
        <td><%= money(o.total) %></td>
        <td><%= o.payment_type %></td>
        <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
        <td class="muted"><%= o.created_at %></td>
        <td><a class="btn btn-sm" href="/admin/orders/<%= o.id %>">Open</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/foot') %>
