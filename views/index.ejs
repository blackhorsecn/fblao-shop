<%- include('partials/head') %>

<section class="store-hero card">
  <div>
    <p class="store-hero-kicker">Minimal storefront · 中文买家友好</p>
    <h1>Fast checkout, clear pricing, and easy order tracking.</h1>
    <p class="store-hero-copy">Browse products quickly, see stock at a glance, and use the payment method that fits you best.</p>
  </div>
  <div class="store-hero-chips">
    <span class="hero-chip">Simple layout / 极简布局</span>
    <span class="hero-chip">Live stock / 实时库存</span>
    <span class="hero-chip">Order lookup / 订单查询</span>
    <% if (magpieEnabled) { %>
      <span class="hero-chip">Alipay 支付宝</span>
      <span class="hero-chip">WeChat Pay 微信支付</span>
      <span class="hero-chip">CNY-friendly 人民币友好</span>
    <% } %>
  </div>
</section>

<% if (banners && banners.length) { %>
  <div class="banner-strip">
    <% banners.forEach(function(b){ %>
      <div class="banner"><%= b.text %></div>
    <% }) %>
  </div>
<% } %>

<% if (!catalog.length) { %>
  <div class="empty-state">No products yet. The shop owner can add products in the <a href="/admin">Admin panel</a>.</div>
<% } %>

<% if (catalog.length) { %>
  <section class="catalog-filters card">
    <div class="catalog-filters-header">
      <div>
        <h2>Browse Products / 商品筛选</h2>
        <p class="muted">Search by product, description, or category, then narrow by price and stock.</p>
      </div>
      <button type="button" class="btn btn-sm" id="catalogFilterClear">Clear filters</button>
    </div>

    <form class="catalog-filter-grid" id="catalogFilters" autocomplete="off">
      <label class="field">
        <span>Search / 搜索</span>
        <input type="text" id="catalogSearch" placeholder="Search products or categories">
      </label>
      <label class="field">
        <span>Min price / 最低价</span>
        <input type="number" id="catalogMinPrice" min="0" step="0.01" placeholder="0.00">
      </label>
      <label class="field">
        <span>Max price / 最高价</span>
        <input type="number" id="catalogMaxPrice" min="0" step="0.01" placeholder="9999.00">
      </label>
      <label class="catalog-checkbox">
        <input type="checkbox" id="catalogInStock">
        <span>Show only in-stock items / 仅看有货</span>
      </label>
    </form>

    <div class="catalog-filter-summary" id="catalogFilterSummary">
      Showing all <strong><%= catalog.reduce(function(total, cat){ return total + cat.products.length }, 0) %></strong> products.
    </div>
  </section>

  <div class="empty-state" id="catalogFilterEmpty" hidden>No products match your current filters. / 当前筛选下暂无商品。</div>
<% } %>

<% catalog.forEach(function(cat){ %>
  <section class="category-block" data-category-block data-category-name="<%= cat.name.toLowerCase() %>">
    <h2 class="category-title">
      <span><%= cat.name %></span>
      <span class="muted" style="font-size: 11px; font-weight: normal; text-transform: uppercase; letter-spacing: 0.05em;"><%= cat.products.length %> Products</span>
    </h2>
    <div class="table-wrap">
      <table class="product-table">
        <thead>
          <tr>
            <th class="col-name">Product</th>
            <th class="col-price">Price</th>
            <th class="col-stock">Stock</th>
            <th class="col-buy"></th>
          </tr>
        </thead>
        <tbody>
          <% cat.products.forEach(function(p){ %>
            <tr
              data-product-row
              data-name="<%= (p.name || '').toLowerCase() %>"
              data-description="<%= (p.description || '').toLowerCase() %>"
              data-category="<%= (cat.name || '').toLowerCase() %>"
              data-price="<%= p.price %>"
              data-stock="<%= p.stock %>">
              <td class="col-name">
                <div class="p-name"><%= p.name %></div>
                <% if (p.description) { %><div class="p-desc"><%= p.description %></div><% } %>
              </td>
              <td class="col-price"><%= money(p.price) %></td>
              <td class="col-stock">
                <% if (p.stock > 0) { %>
                  <span class="stock-ok"><%= p.stock %></span>
                <% } else { %>
                  <span class="stock-out">Sold out</span>
                <% } %>
              </td>
              <td class="col-buy">
                <% if (p.stock > 0) { %>
                  <button class="btn btn-buy"
                          data-id="<%= p.id %>"
                          data-name="<%= escapeHtml(p.name) %>"
                          data-price="<%= p.price %>"
                          data-stock="<%= p.stock %>"
                          data-min="<%= p.min_quantity || 1 %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    Buy Now / 立即购买
                  </button>
                <% } else { %>
                  <button class="btn btn-disabled" disabled>Out of Stock / 缺货</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% }) %>

<!-- Purchase modal -->
<div class="modal-overlay" id="buyModal">
  <div class="modal">
    <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>
    <h3 class="modal-title">Buy / 购买 <span id="m-product"></span></h3>
    <form method="POST" action="/order" id="buyForm">
      <input type="hidden" name="product_id" id="m-product-id">

      <div class="modal-note">
        Clear checkout with buyer-friendly payment choices.
        <% if (magpieEnabled) { %>支持支付宝 / 微信支付。<% } %>
      </div>

      <label class="field">
        <span>Telegram Username / 电报用户名</span>
        <input type="text" name="telegram_username" id="m-telegram" required placeholder="@username" value="<%= user ? user.username : '' %>">
        <small class="muted">Your order details and delivery will be linked to this username.</small>
      </label>

      <div class="field-row">
        <label class="field">
          <span>Quantity / 数量</span>
          <input type="number" name="quantity" id="m-qty" value="1" min="1" required>
        </label>
        <div class="field">
          <span>Unit price / 单价</span>
          <div class="readout" id="m-unit"></div>
        </div>
        <div class="field">
          <span>Total / 合计</span>
          <div class="readout total" id="m-total"></div>
        </div>
      </div>

      <fieldset class="field pay-methods">
        <legend>Payment method / 支付方式</legend>
        <% if (mayaEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="maya" checked>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('maya') %>" alt="Maya">
               <span><strong>Maya Checkout</strong> — pay with Maya, GCash, or Card</span>
            </div>
          </label>
        <% } %>
        <% if (coinsEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="coins" <%= !mayaEnabled ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('coins.ph') %>" alt="Coins.ph">
               <span><strong>Coins.ph Enterprise</strong> — Instant Crypto/Wallet payment</span>
            </div>
          </label>
        <% } %>
        <% if (paymongoEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="paymongo" <%= (!mayaEnabled && !coinsEnabled) ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('paymongo') %>" alt="PayMongo">
               <span><strong>PayMongo</strong> — GCash, Maya, Cards, BillEase</span>
            </div>
          </label>
        <% } %>
        <% if (xenditEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="xendit" <%= (!mayaEnabled && !coinsEnabled && !paymongoEnabled) ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('xendit') %>" alt="Xendit">
               <span><strong>Xendit</strong> — Invoices (PH/ID Local Payments)</span>
            </div>
          </label>
        <% } %>
        <% if (swiftpayEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="swiftpay" <%= (!mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !magpieEnabled) ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('swiftpay') %>" alt="Swiftpay PH">
               <span><strong>Swiftpay PH</strong> — Fast online checkout</span>
            </div>
          </label>
        <% } %>
        <% if (magpieEnabled) { %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="magpie_alipay" <%= (!mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !swiftpayEnabled) ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('alipay') %>" alt="Alipay">
               <span><strong>Magpie Alipay</strong> — auto-converted to CNY</span>
            </div>
          </label>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="magpie_wechat" <%= (!mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !swiftpayEnabled) ? 'checked' : '' %>>
            <div class="pay-option-body">
              <img class="pay-option-logo" src="<%= getIcon('wechat') %>" alt="WeChat Pay">
               <span><strong>Magpie WeChat Pay</strong> — auto-converted to CNY</span>
            </div>
          </label>
        <% } %>
        <% manualMethods.forEach(function(m, i){ %>
          <label class="pay-option" style="display: flex; align-items: center; gap: 12px;">
            <input type="radio" name="payment_type" value="manual"
                   data-manual="<%= m.id %>" <%= (!mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !swiftpayEnabled && !magpieEnabled && i === 0) ? 'checked' : '' %>>
            <div class="pay-option-body">
               <% var icon = getIcon(m.name, m.icon_url); %>
               <% if (icon) { %>
                 <img class="pay-option-logo" src="<%= icon %>" alt="<%= m.name %>">
               <% } else { %>
                 <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; background: var(--panel-2); border-radius: 4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg></div>
               <% } %>
               <span><strong><%= m.name %></strong> — manual transfer</span>
            </div>
          </label>
        <% }) %>
        <% if (!mayaEnabled && !coinsEnabled && !paymongoEnabled && !xenditEnabled && !swiftpayEnabled && !magpieEnabled && !manualMethods.length) { %>
          <p class="muted">No payment methods are configured yet.</p>
        <% } %>
      </fieldset>
      <input type="hidden" name="manual_method_id" id="m-manual-id">

      <% if (settings.cf_turnstile_site_key) { %>
        <div class="field" style="margin-top: 15px; display: flex; justify-content: center;">
          <div class="cf-turnstile" data-sitekey="<%= settings.cf_turnstile_site_key %>"></div>
        </div>
      <% } %>

      <button type="submit" class="btn btn-primary btn-block" id="m-submit" style="margin-top: 15px;">Proceed to payment / 去付款</button>
    </form>
  </div>
</div>

<%- include('partials/foot') %>
